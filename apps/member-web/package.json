{
  "name": "@gig-planner/member-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port ${GIG_PLANNER_MEMBER_PORT:-5173} --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@gig-planner/api-client": "file:../../packages/api-client",
    "@gig-planner/ui": "file:../../packages/ui"
  }
}
